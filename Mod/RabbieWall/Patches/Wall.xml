<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Extrait de « Rabbie The Moonrabbit race » (Runne Latki).

     Les deux seuls elements muraux du mod. L'applique est fonctionnelle, elle eclaire : c'est
     assume, comme les deux lampes de bureau du meme mod cotees ailleurs dans ce mod-ci.

     NON REPRIS : le miroir et les fenetres de mur, qui sont en couche Building sans
     canPlaceOverWall ; le mur lui-meme, en Graphic_Appearances.

     TOUT EST SOUS PatchOperationFindMod. Sans Colonists' Deco, `ColonistsDeco.WallDeco_Default`
     et `ColonistsDeco.DecoModExtension` ne resolvent pas - et une `<modExtensions>` non resolue
     fait echouer la def ENTIERE, pas seulement l'extension.

     UN FindMod PAR DEF, et non un seul pour tout le fichier : `PatchOperationSequence` s'arrete
     a la premiere operation qui echoue. Isoler chaque def evite qu'un seul echec emporte les
     suivantes.

     Les mods sont nommes deux fois, par nom affiche et par packageId, pour resister a un
     renommage.

     Chaque groupe est conditionnel : le noeud est cree s'il manque, complete s'il existe. -->

  <!--===== LSK_SHS_Elegance_Window : Elegant window =====-->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Colonists' Deco (Continued)</li>
      <li>Mlie.ColonistsDeco</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]/thingClass</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]/thingClass</xpath>
            <value><thingClass>ColonistsDeco.WallDeco_Default</thingClass></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]</xpath>
            <value><thingClass>ColonistsDeco.WallDeco_Default</thingClass></value>
          </nomatch>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]/comps</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]/comps</xpath>
            <value>
              <li Class="ColonistsDeco.CompProperties_Decoration">
                <decorationName>Elegant window</decorationName>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]</xpath>
            <value>
              <comps>
                <li Class="ColonistsDeco.CompProperties_Decoration">
                  <decorationName>Elegant window</decorationName>
                </li>
              </comps>
            </value>
          </nomatch>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]/modExtensions</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]/modExtensions</xpath>
            <value>
              <li Class="ColonistsDeco.DecoModExtension">
                <decoTechLevels>
                  <li>Industrial</li>
                  <li>Spacer</li>
                </decoTechLevels>
                <decoLocationType>Wall</decoLocationType>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Elegance_Window"]</xpath>
            <value>
              <modExtensions>
                <li Class="ColonistsDeco.DecoModExtension">
                  <decoTechLevels>
                    <li>Industrial</li>
                    <li>Spacer</li>
                  </decoTechLevels>
                  <decoLocationType>Wall</decoLocationType>
                </li>
              </modExtensions>
            </value>
          </nomatch>
        </li>

      </operations>
    </match>
  </Operation>

  <!--===== LSK_SHS_Wall_Light : Wall lamp =====-->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Colonists' Deco (Continued)</li>
      <li>Mlie.ColonistsDeco</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]/thingClass</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]/thingClass</xpath>
            <value><thingClass>ColonistsDeco.WallDeco_Default</thingClass></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]</xpath>
            <value><thingClass>ColonistsDeco.WallDeco_Default</thingClass></value>
          </nomatch>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]/comps</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]/comps</xpath>
            <value>
              <li Class="ColonistsDeco.CompProperties_Decoration">
                <decorationName>Wall lamp</decorationName>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]</xpath>
            <value>
              <comps>
                <li Class="ColonistsDeco.CompProperties_Decoration">
                  <decorationName>Wall lamp</decorationName>
                </li>
              </comps>
            </value>
          </nomatch>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]/modExtensions</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]/modExtensions</xpath>
            <value>
              <li Class="ColonistsDeco.DecoModExtension">
                <decoTechLevels>
                  <li>Industrial</li>
                  <li>Spacer</li>
                </decoTechLevels>
                <decoLocationType>Wall</decoLocationType>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="LSK_SHS_Wall_Light"]</xpath>
            <value>
              <modExtensions>
                <li Class="ColonistsDeco.DecoModExtension">
                  <decoTechLevels>
                    <li>Industrial</li>
                    <li>Spacer</li>
                  </decoTechLevels>
                  <decoLocationType>Wall</decoLocationType>
                </li>
              </modExtensions>
            </value>
          </nomatch>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
