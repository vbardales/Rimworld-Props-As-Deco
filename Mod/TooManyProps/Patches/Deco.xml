<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Extrait de « Too Many Props (Continued) » (Zaljerem).

     Seulement six defs sur trente-huit passent : le mod est surtout fait de gros elements de
     decor au sol. Les six qui restent sont son fichier TableDefs.xml, c'est-a-dire exactement
     ce qu'on cherche - piles de livres, jeux de fioles, tas de pieces. -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TMPTablePropsBooksA"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_BedroomClutter</li>
      </buildingTags>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TMPTablePropsBooksB"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_BedroomClutter</li>
      </buildingTags>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TMPTablePropsPotionsA"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_BedroomClutter</li>
      </buildingTags>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TMPTablePropsPotionsB"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_BedroomClutter</li>
      </buildingTags>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TMPTablePropsA"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_BedroomClutter</li>
      </buildingTags>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TMPTablePropsB"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_BedroomClutter</li>
      </buildingTags>
    </value>
  </Operation>

</Patch>
