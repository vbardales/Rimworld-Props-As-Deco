<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Extrait de « Wall Decorations » (bazoka81).

     Douze decorations murales confiees a Colonists' Deco : un colon les accroche lui-meme au
     titre du loisir, au lieu que tu les poses.

     Elles etaient deja structurellement pretes - 1x1, altitudeLayer BuildingOnTop,
     canPlaceOverWall, Graphic_Multi. Il ne manquait que le contrat de Colonists' Deco.

     NON REPRIS :
     - Les huit motifs de lierre en 2x1 : toutes les decos de Colonists' Deco sont en 1x1, sa
       logique cherche une case de mur.
     - ucp_wallswitch : c'est un `Building_PowerSwitch`, un interrupteur fonctionnel. Lui
       remplacer son thingClass casserait sa fonction.
     - ucp_wallsocket : porte des composants electriques, meme prudence.

     TOUT EST SOUS PatchOperationFindMod. Sans Colonists' Deco, `ColonistsDeco.WallDeco_Default`
     et `ColonistsDeco.DecoModExtension` ne resolvent pas - et une `<modExtensions>` non resolue
     fait echouer la def ENTIERE, pas seulement l'extension.

     UN FindMod PAR DEF, et non un seul pour tout le fichier : `PatchOperationSequence` s'arrete
     a la premiere operation qui echoue. Isoler chaque def evite qu'un seul echec emporte les
     suivantes.

     Les mods sont nommes deux fois, par nom affiche et par packageId, pour resister a un
     renommage.

     Chaque groupe est conditionnel : le noeud est cree s'il manque, complete s'il existe. -->

  <!--===== ucp_toiletpaper : Toilet paper =====-->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Colonists' Deco (Continued)</li>
      <li>Mlie.ColonistsDeco</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]/thingClass</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]/thingClass</xpath>
            <value><thingClass>ColonistsDeco.WallDeco_Default</thingClass></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]</xpath>
            <value><thingClass>ColonistsDeco.WallDeco_Default</thingClass></value>
          </nomatch>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]/comps</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]/comps</xpath>
            <value>
              <li Class="ColonistsDeco.CompProperties_Decoration">
                <decorationName>Toilet paper</decorationName>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]</xpath>
            <value>
              <comps>
                <li Class="ColonistsDeco.CompProperties_Decoration">
                  <decorationName>Toilet paper</decorationName>
                </li>
              </comps>
            </value>
          </nomatch>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]/modExtensions</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]/modExtensions</xpath>
            <value>
              <li Class="ColonistsDeco.DecoModExtension">
                <decoTechLevels>
                  <li>Industrial</li>
                  <li>Spacer</li>
                </decoTechLevels>
                <decoLocationType>Wall</decoLocationType>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="ucp_toiletpaper"]</xpath>
            <value>
              <modExtensions>
                <li Class="ColonistsDeco.DecoModExtension">
                  <decoTechLevels>
                    <li>Industrial</li>
                    <li>Spacer</li>
                  </decoTechLevels>
                  <decoLocationType>Wall</decoLocationType>
                </li>
              </modExtensions>
            </value>
          </nomatch>
        </li>

      </operations>
    </match>
  </Operation>

