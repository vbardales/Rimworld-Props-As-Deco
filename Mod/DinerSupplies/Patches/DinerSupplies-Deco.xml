<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Extrait de « Diner Supplies » (LUNARTIKA).

     Treize defs, treize conformes, treize retenues : hamburgers, frites, sodas, plateaux,
     gobelets usages et carte du menu. Aucun tri a faire, tout va au refectoire. -->

  <Operation Class="PatchOperationConditional"><!-- ensure-own-building -->
    <xpath>Defs/ThingDef[defName="DS_BurgerF"]/building</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="DS_BurgerF"]</xpath>
      <value><building /></value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DS_BurgerF"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_DiningRoomClutter</li>
      </buildingTags>
    </value>
  </Operation>

