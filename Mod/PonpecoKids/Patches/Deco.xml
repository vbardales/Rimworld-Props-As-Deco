<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Extrait de « Ponpeco Furnitures : Kids' Room » (ponpeco).

     Bazar de chambre d'enfant : ballon, coussin, trois grosses peluches, huit jouets en bois et
     trois peluches PKC. Exactement le cas d'usage de Knick Knacks.

     CONVERSION NECESSAIRE : ces objets sont en altitudeLayer BuildingBelowTop, pas BuildingOnTop.
     Ils se dessineraient sous la table au lieu de dessus. On convertit la couche et isEdifice
     par conditionnel, pour marcher que le champ soit declare sur la def ou herite de sa base.

     NON REPRIS : les trois guirlandes de fanions, les deux rideaux et la guirlande lumineuse -
     ce sont des elements muraux ou de plafond, ils relevent de Colonists' Deco. -->

  <!-- PFK_Ball : conversion de couche puis tags -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="PFK_Ball"]/altitudeLayer</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="PFK_Ball"]/altitudeLayer</xpath>
      <value><altitudeLayer>BuildingOnTop</altitudeLayer></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="PFK_Ball"]</xpath>
      <value><altitudeLayer>BuildingOnTop</altitudeLayer></value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="PFK_Ball"]/building/isEdifice</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="PFK_Ball"]/building/isEdifice</xpath>
      <value><isEdifice>false</isEdifice></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="PFK_Ball"]/building</xpath>
      <value><isEdifice>false</isEdifice></value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="PFK_Ball"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_BedroomClutter</li>
      </buildingTags>
    </value>
  </Operation>

