  <!-- Extrait de « Office Supplies » (LUNARTIKA).

     Vingt-quatre defs, toutes conformes. Materiel de bureau : machines a ecrire, telephone,
     sonnette, presse-papiers, enveloppes, loupe, balance. Va en chambre, faute de categorie
     bureau chez Knick Knacks.

     Les cinq objets de bouche - gamelles, boite a cafe et tasses - vont au refectoire. -->

  <Operation Class="PatchOperationConditional"><!-- ensure-own-building -->
    <xpath>Defs/ThingDef[defName="OS_Magnifier"]/building</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="OS_Magnifier"]</xpath>
      <value><building /></value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="OS_Magnifier"]/building</xpath>
    <value>
      <buildingTags>
        <li>SEX_Clutter</li>
        <li>SEX_BedroomClutter</li>
      </buildingTags>
    </value>
  </Operation>

